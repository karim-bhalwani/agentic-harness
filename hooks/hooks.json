{
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/quality-gate.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\quality-gate.ps1\"",
        "timeout": 60
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/scan-secrets.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\scan-secrets.ps1\"",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/retrospective-check.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\retrospective-check.ps1\"",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/block-holdout.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\block-holdout.ps1\"",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/block-destructive.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\block-destructive.ps1\"",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/lint-on-write.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\lint-on-write.ps1\"",
        "timeout": 20
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/cap-subagent-budget.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\cap-subagent-budget.ps1\"",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/auto-format.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\auto-format.ps1\"",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/artifact-manifest.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\artifact-manifest.ps1\"",
        "timeout": 10
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/verify-hook-integrity.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\verify-hook-integrity.ps1\"",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/session-context.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\session-context.ps1\"",
        "timeout": 10
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/subagent-context.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\subagent-context.ps1\"",
        "timeout": 10
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/pre-compact-save.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\pre-compact-save.ps1\"",
        "timeout": 15
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/scan-user-prompt.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\scan-user-prompt.ps1\"",
        "timeout": 10
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -File ~/.copilot/hooks/subagent-verify.ps1",
        "windows": "pwsh -NoProfile -Command \"& ~\\.copilot\\hooks\\subagent-verify.ps1\"",
        "timeout": 30
      }
    ]
  }
}
